# Express
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/lost-hill

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev (through the Vite proxy):  http://localhost:5173/auth/google/callback
# Production:                    https://losthill.online/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback

# Matching (all optional; without keys the site ranks by words, distance, date, category)
# Embeddings, computed once per report. Pick one:
#   jina       text + photo in one space (https://jina.ai, free key, check current limits and licence)
#   cloudflare text only (Workers AI, bge-m3)
EMBEDDING_PROVIDER=
JINA_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Verification of the top 3 results. Tried in this order; the first that answers wins.
VERIFY_PROVIDERS=mistral,gemini
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Global daily AI budget across all users (calls per UTC day)
AI_DAILY_CAP_VERIFY=300
AI_DAILY_CAP_EMBED=1500

# Photos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
